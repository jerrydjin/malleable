+// This term is a decision cost only. The physical incident and all make-way
+// acceptance limits remain unchanged. Read only this car's KnownHazard.
+fn record_known_route_cost(free_s:f64, known:&KnownHazard, now:f64)->f64 {
+    free_s+if known.learned_at<=now {(known.expires_at-now).max(0.0)}else{0.0}
+}
+// A yielding detour's 25% distance ceiling must not suppress a cheaper route
+// around a known road closure. No physical length is fabricated: the exception
+// compares declared time costs, then the existing receiver checks legality.
+fn record_hazard_choice(terms:&make_way::RouteTerms, known:&KnownHazard, now:f64)->make_way::DrivingAction {
+    let mut t=terms.clone();t.old_free_s=record_known_route_cost(terms.old_free_s,known,now);
+    let mut action=make_way::route_choice(&t);
+    let has_wait=known.learned_at<=now && known.expires_at>now;
+    if action==make_way::DrivingAction::Ignore && has_wait && t.connected && t.reached && t.on_path_ahead
+        && t.reroutes && !t.lane_changes && t.parallel.is_none() && !t.same_links
+        && t.old_remaining_m>0.0 && t.new_remaining_m>0.0
+        && t.new_free_s+t.new_block_s<=t.old_free_s+3.0 {
+        action=make_way::DrivingAction::Reroute(Vec::new());
+    }
+    action
+}
+#[cfg(test)]
+mod v2_cost_tests {
+    use super::*;
+    #[test]
+    fn known_remaining_blockage_changes_the_old_route_cost_without_changing_make_way() {
+        let known=KnownHazard {learned_at:240.0,expires_at:1140.0,source:"sensor".into()};
+        assert_eq!(record_known_route_cost(57.6,&known,540.0),657.6);
+        assert_eq!(record_known_route_cost(57.6,&known,1141.0),57.6);
+        assert_eq!(record_known_route_cost(57.6,&known,239.0),57.6);
+        let mut t=make_way::RouteTerms {connected:true,reached:true,on_path_ahead:true,lane_changes:false,reroutes:true,
+            parallel:None,gap_ok:false,room_before_exit:false,old_free_s:57.6,new_free_s:74.2,old_remaining_m:1000.0,
+            new_remaining_m:1100.0,new_block_s:0.0,same_links:false};
+        assert_eq!(make_way::route_choice(&t),make_way::DrivingAction::Ignore);
+        t.old_free_s=record_known_route_cost(57.6,&known,540.0);
+        assert!(matches!(make_way::route_choice(&t),make_way::DrivingAction::Reroute(_)));
+        t.old_free_s=44.878780964987584;t.new_free_s=61.49314886769604;t.new_block_s=332.5;
+        t.old_remaining_m=554.047836188673;t.new_remaining_m=703.7128685801151;
+        let mut yield_terms=t.clone();yield_terms.old_free_s=record_known_route_cost(t.old_free_s,&known,240.0);
+        assert_eq!(make_way::route_choice(&yield_terms),make_way::DrivingAction::Ignore);
+        assert!(matches!(record_hazard_choice(&t,&known,240.0),make_way::DrivingAction::Reroute(_)));
+        assert_eq!(record_hazard_choice(&t,&known,1141.0),make_way::DrivingAction::Ignore);
+    }
+}
